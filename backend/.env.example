# ============================================================================
# Mugutha FC Platform - Backend Configuration (.env.example)
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values.
# Never commit .env with real secrets to git.

# ---- Database (Supabase) ----
# Sign up at https://supabase.com and create a project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ---- Server ----
PORT=5000

# ============================================================================
# WhatsApp Integration
# ============================================================================
# WHATSAPP_PROVIDER: Which provider to use
#   - "mock"   : Local mock provider (for demo/testing, no credentials needed)
#   - "twilio" : Twilio API (requires API_URL, API_TOKEN)
#   - other    : Custom provider
WHATSAPP_PROVIDER=mock

# WHATSAPP_API_URL: Provider endpoint URL
#   For mock: http://localhost:5000/internal/mock-whatsapp
#   For twilio: https://api.twilio.com/...
#   For other providers: https://your-provider-api.com/...
WHATSAPP_API_URL=http://localhost:5000/internal/mock-whatsapp

# WHATSAPP_API_TOKEN: Provider authentication token
#   For mock: ignored (mock provider doesn't authenticate)
#   For twilio: your Twilio Auth Token
WHATSAPP_API_TOKEN=your_whatsapp_token_here

# WHATSAPP_API_KEY: Provider authentication key (alternative to token)
WHATSAPP_API_KEY=your_whatsapp_key_here

# WHATSAPP_FROM_NUMBER: Sender phone number (your WhatsApp Business number)
#   Format: +254712345678 (country code + number)
WHATSAPP_FROM_NUMBER=+254712345678

# WHATSAPP_BUSINESS_ACCOUNT_ID: your WhatsApp Business Account ID (Meta > WhatsApp Manager).
#   Needed to submit templates: node scripts/submit-templates.js
#   This is NOT the phone number ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# MOCK_WHATSAPP_DELAY_MS: Simulated network delay (milliseconds)
#   Default: 2000 (2 seconds)
#   Use to simulate cloud provider latency during testing
#   Example: 5000 = simulate 5 second delay
MOCK_WHATSAPP_DELAY_MS=2000

# ============================================================================
# Security
# ============================================================================
# ADMIN_EMAILS: who may use the dashboard (comma-separated). Create each admin in
#   Supabase > Authentication > Users > Add user, then list their email here.
ADMIN_EMAILS=

# WHATSAPP_APP_SECRET: Meta for Developers > your app > App settings > Basic > App secret.
#   Used to check that webhook messages really come from Meta.
WHATSAPP_APP_SECRET=

# CORS_ORIGINS: the dashboard's address(es), comma-separated.
#   e.g. https://mugutha-fanclub.vercel.app,http://127.0.0.1:5173
CORS_ORIGINS=

# ============================================================================
# Scheduler
# ============================================================================
# SCHEDULER_ENABLED: Enable/disable scheduled broadcast jobs
SCHEDULER_ENABLED=true

# ============================================================================
# Quick Start Guide
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# 3. For demo: keep WHATSAPP_PROVIDER=mock (no additional setup needed)
# 4. For production: set WHATSAPP_PROVIDER to your provider and add credentials
# 5. Run: npm install && npm run dev

# ============================================================================
# M-Pesa (join and pay)
# ============================================================================
# Sandbox keys: developer.safaricom.co.ke > My Apps. Sandbox shortcode 174379
# and its passkey are on the Daraja "Lipa Na M-Pesa Online" test page.
MPESA_ENV=sandbox
MPESA_SANDBOX_CONSUMER_KEY=
MPESA_SANDBOX_CONSUMER_SECRET=
MPESA_PRODUCTION_CONSUMER_KEY=
MPESA_PRODUCTION_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public https address of this backend + /mpesa/callback (ngrok when testing locally)
MPESA_CALLBACK_URL=https://your-backend.example.com/mpesa/callback
# Only for a Buy Goods till (leave empty for a paybill)
MPESA_TILL_NUMBER=
MPESA_ACCOUNT_REFERENCE=MUGUTHA FC

# Tier prices in KSh (placeholders until the club confirms)
TIER_PRICE_BRONZE=500
TIER_PRICE_SILVER=1000
TIER_PRICE_GOLD=2000
MEMBERSHIP_DAYS=365

# ============================================================================
# Match alerts and renewal reminders
# ============================================================================
# The club's name, and a word that appears in its team name in fixtures.
CLUB_NAME=Mugutha FC
# Shown above the club name on the dashboard (optional), e.g. County League
CLUB_LEAGUE=
CLUB_MATCH_WORD=mugutha
# Home ground: name (as typed in fixtures) and map pin, for weather and directions.
#   In Google Maps, right-click the ground and click the numbers to copy them.
CLUB_GROUND_NAME=Mugutha
CLUB_GROUND_LAT=
CLUB_GROUND_LNG=
# Include demo members in alerts and reminders. Only works with WHATSAPP_PROVIDER=mock,
# so demo data can never message real numbers.
ALERT_INCLUDE_DEMO=false
