 using a shadow on top of the content in .chit */\n    position: absolute;\n    inset: 0;\n    box-shadow: inset 0 0 0 1px var(--color-border-selected);\n    transform: scale(1);\n  }\n\n.chit--chitBorder---ff5t {\n  position: absolute;\n\n  /* Our goal is to draw a 0.5px \"hairline\" border around these chits. However, Chrome\n      doesn't support sub-pixel borders and Safari doesn't support sub-pixel box-shadows,\n      so we use this hack where we draw a 1px box at twice the size and then scale it down. */\n  top: -50%;\n  left: -50%;\n  right: -50%;\n  bottom: -50%;\n  box-shadow: inset 0 0 0 1px var(--color-border);\n  transform-origin: center center;\n  transform: scale(0.5);\n}\n\n[data-fpl-version='ui3'] .chit--chitBorder---ff5t, :where([data-fpl-ui3-override]) .chit--chitBorder---ff5t {\n    /* Border radius is a percentage instead of an actual value since we render chits\n    at various sizes (see: gridVariableChit), this ensures its always the right radius no matter the size */\n    border-radius: 20%;\n}\n\n/* The above fix looks good everywhere except in FireFox on low-density displays. In that\n   case, we just throw our hands in the air and render a 1px border around the chit. */\n\n@media screen and (max-resolution: 1.5dppx) {\n  @supports (-moz-appearance: none) {\n    .chit--chitBorder---ff5t {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      box-shadow: inset 0 0 0 1px var(--color-border);\n      transform: none;\n    }\n  }\n}\n"},714494(e,t,r){r.d(t,{$:()=>y,$f:()=>o,As:()=>f,Bx:()=>b,DQ:()=>O,Gz:()=>c,K5:()=>a,LK:()=>S,Om:()=>s,UU:()=>m,Ul:()=>A,VB:()=>d,ZM:()=>E,ab:()=>i,bE:()=>I,cZ:()=>l,fz:()=>h,it:()=>v,lF:()=>g,mL:()=>T,n:()=>n,vQ:()=>_,y4:()=>p,yW:()=>u,zz:()=>C});let n="colors_inspect_panel--colorContainer--RM4cT",i="colors_inspect_panel--colorContainerUI3--oxjqp colors_inspect_panel--colorContainer--RM4cT",a="colors_inspect_panel--propertyColorRowTall---HNAm colors_inspect_panel--_prop