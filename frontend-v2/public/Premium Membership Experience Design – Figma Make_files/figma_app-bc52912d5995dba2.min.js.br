}`,i=`import { useState, type CSSProperties, type PointerEvent } from "react";

export default function App() {
  const [hovering, setHovering] = useState(false);
  const [cursor, setCursor] = useState({ x: 0, y: 0 });

  const handlePointerMove = (event: PointerEvent<HTMLDivElement>) => {
    const rect = event.currentTarget.getBoundingClientRect();
    setCursor({ x: event.clientX - rect.left, y: event.clientY - rect.top });
  };

  // The hover layer is the same dot grid scaled up, revealed only within a soft
  // circle that follows the cursor \u{2014} so dots appear to bloom under the pointer.
  const mask = \`radial-gradient(circle at \${cursor.x}px \${cursor.y}px, #000 72px, transparent 120px)\`;

  const container: CSSProperties = {
    position: "relative",
    width: "100%",
    height: "100%",
    overflow: "hidden",
    backgroundColor: "#f8fbff",
  };
  const dots: CSSProperties = {
    position: "absolute",
    inset: 0,
    backgroundImage:
      "radial-gradient(circle at center, rgba(157, 200, 255, 0.52) 1.2px, transparent 1.4px)",
    backgroundPosition: "center",
    backgroundSize: "18px 18px",
  };
  const dotsHover: CSSProperties = {
    position: "absolute",
    inset: 0,
    backgroundImage:
      "radial-gradient(circle at center, rgba(157, 200, 255, 0.52) 2.16px, transparent 2.36px)",
    backgroundPosition: "center",
    backgroundSize: "18px 18px",
    opacity: hovering ? 1 : 0,
    maskImage: mask,
    WebkitMaskImage: mask,
  };

  return (
    <div
      style={container}
      onPointerEnter={() => setHovering(true)}
      onPointerMove={handlePointerMove}
      onPointerLeave={() => setHovering(false)}
    >
      <div style={dots} />
      <div style={dotsHover} />
    </div>
  );
}`,a="/styles/globals.css",o="/src/styles/theme.css",s="/src/styles",l="/src/styles/index.css"},678853(e,t,r){r.d(t,{Hs:()=>b,Vf:()=>v,a1:()=>g,my:()=>y,xW:()=>T});var n=r(936307),i=r(214105),a=r(53175),o=r(191385),s=r(506320),l=r(478687),d=r(815520),c=r(219904),u=r(33217),p=r(952231),_=r(758973),m=r(348603),h=r(564318),f=r(293337);async function g({nodes:e,shouldExportImageFill:t,getFallbackFill:r,functionalDependencies:n}){let{trackExport:i}=n;async function a(){let i=function(e){var t;if(e.length>1)return!1;let r=e[0];if(!r.fills||!r.size||!r.size.x||!r.size.y)return!1;let n=r.fills.map((e,t)=>({fill:e,index:t})).filter(({fill:e})=>!1!==e.visible&&(e.opacity??1)>0);if(1!==n.length)return!1;let i=n[0];if(i?.fill.type!=="IMAGE"||(t=r.absoluteTransform)&&t.m00*t.m11-t.m01*t.m10<0)return!1;let a=m.Pjp?.getUVTransformForImageTarget({guid:r.guid,fillIndex:i.index,componentPropDefId:null});return!!a&&function(e,t=1e-6){return!e||Math.abs(e.m00-1)<t&&Math.abs(e.m01)<t&&Math.abs(e.m02)<t&&Math.abs(e.m10)<t&&Math.abs(e.m11-1)<t&&Math.abs(e.m12)<t}(a)}(e);return t&&!i?{...await E(e,n),shouldExport:t,canSkipExport:i,exported:!0}:{...{node:e[0],fill:await r(),cleanup:()=>{}},shouldExport:t,canSkipExport:i,exported:!1}}return(0,l.r)(a,i)}async function E(e,t){let r=function(e){if(e.length>1)return"image/png";let t=e[0],r=t.fills?.find(e=>"IMAGE"===e.type&&!1!==e.visible),n=r?.image?.hash;if(!n)return"image/png";let i=h.Bko?.getCompressedImage((0,o.Rw)(n));return!i||i.byteLength<=4?"image/png":(0,a.E)(i).mimeType}(e),{width:n,height:i,blob:s,loadImagesLatencyMs:l}=await (0,p.o4)(e,{exportSettings:[{contentsOnly:!0,constraint:function(e){if(e.length>1){let{width:t,height:r}=function(e){let t=c.r.invalidRect();for(let r of e){let e=r.absoluteBoundingBox;if(!e)continue;let n=new c.r(new u.Mi(e.x,e.y),new u.Mi(e.w,e.h));t=t.unionWith(n)}if(t.isInvalid())throw Error("Unable to compute bounds for nodes");return{width:t.size.x,height:t.size.y}}(e);return v(t,r,4096)??{type:"CONTENT_SC