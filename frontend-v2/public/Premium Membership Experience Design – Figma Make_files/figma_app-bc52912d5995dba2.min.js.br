      scrollbar-color: transparent transparent;
    }
    html:hover, body:hover {
      scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
    }
    #container, #container > div {
      height: auto !important;
      width: 100% !important;
      max-width: 100% !important;
    }
