@group(0) @binding(1) var inputSampler: sampler;

@fragment
fn fs_main(in: VSOut) -> @location(0) vec4<f32> {
  let uv = floor(in.uv * 32.0) / 32.0;
  return textureSample(inputTex, inputSampler, uv);
}
