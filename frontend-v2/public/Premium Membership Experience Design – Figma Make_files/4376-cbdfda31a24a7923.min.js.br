nts/instances bug related to the conditional rendering of keyframe tracks.\n  let startFrom: number\n  let startTo: number\n  let endFrom: number\n  let endTo: number\n  let startEnabled = true\n  let endEnabled = true\n\n  if (type === TYPE_DRAW || type === TYPE_ERASE) {\n    const isDraw = type === TYPE_DRAW\n    if (isDraw && isForward) {\n      startFrom = 0\n      startTo = 0\n      endFrom = 0\n      endTo = 1\n    } else if (isDraw && !isForward) {\n      startFrom = 1\n      startTo = 0\n      endFrom = 1\n      endTo = 1\n    } else if (!isDraw && isForward) {\n      startFrom = 0\n      startTo = 1\n      endFrom = 1\n      endTo = 1\n    } else {\n      startFrom = 0\n      startTo = 0\n      endFrom = 1\n      endTo = 0\n    }\n  } else if (type === TYPE_TRAVEL) {\n    // A fixed-length segment travels along the path and comes to rest at the end. The trim\n    // values stay within [0, 1] (the segment never runs past either end) so the path doesn't\n    // wrap / loop the segment back around to the start.\n    //   forward: segment moves [0, seg] \u2192 [1 - seg, 1]\n    //   reverse: segment moves [1 - seg, 1] \u2192 [0, seg]\n    const segmentFraction = percentToDecimal(segment)\n    startFrom = isForward ? 0 : 1 - segmentFraction\n    startTo = isForward ? 1 - segmentFraction : 0\n    endFrom = isForward ? segmentFraction : 1\n    endTo = isForward ? 1 : segmentFraction\n  } else {\n    // type === 'custom' \u2014 `axis` toggles which trim(s) are enabled; all custom modes share\n    // `duration` / `easing`. Combined groups both Starts then both Ends in the panel, so it\n    // reads the combined-only variants for the inner pair (trimStart's End, trimEnd's Start).\n    startEnabled = axis === AXIS_PATH_TRIM_START || axis === AXIS_COMBINED\n    endEnabled = axis === AXIS_PATH_TRIM_END || axis === AXIS_COMBINED\n    if (axis === AXIS_COMBINED) {\n      const sFrom = percentToDecimal(pathStartStartFrame)\n      const sTo = percentToDecimal(pathStartEndWi