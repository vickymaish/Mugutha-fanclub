(e){if(!n.has(e))throw console.warn(`Asset ${e} not found in assets map`),Error(`Asset ${e} not found`);let t=n.get(e);if(!t)throw Error(`Blob for asset ${e} is undefined`);return new Uint8Array(await t.arrayBuffer())}let s="http://localhost:3845/assets";function o(e){return new Promise((t,i)=>{let n=new FileReader;n.onload=()=>{let e=n.result;"string"==typeof e?t(e.split(",")[1]||""):i(Error("Unexpected FileReader result type"))},n.onerror=()=>i(n.error??Error("FileReader failed")),n.readAsDataURL(e)})}},6521(e,t,i){"use strict";function n(e){return e.replace(/-/g,":")}i.d(t,{$:()=>n})},642278(e,t,i){"use strict";i.d(t,{M:()=>n});let n=["React","Web Components","Vue","Svelte","Storybook","Javascript","Swift","Swift UIKit","Objective-C UIKit","SwiftUI","Compose","Java","Kotlin","Android XML Layout","Flutter","Markdown"]},158800(e,t,i){"use strict";let n;i.d(t,{jKT:()=>W,Ifg:()=>G,x8v:()=>K,nn$:()=>z,Y9L:()=>U,vkO:()=>V,qaI:()=>B,iB$:()=>q,NEL:()=>I,d1E:()=>E,fLQ:()=>L,Ob1:()=>F,YHz:()=>M,oAo:()=>O,xyD:()=>P,pkL:()=>D,HHR:()=>Y,Zj1:()=>H,lqp:()=>b,sjb:()=>d,A$X:()=>m,jAH:()=>h,pvU:()=>l,$8z:()=>A,uft:()=>c,CaX:()=>p,n7l:()=>u,REo:()=>g,o6r:()=>y,avJ:()=>v,J9x:()=>_,TSV:()=>f,npl:()=>j});var r,a,s=i(831679),o=i(703153);n=`SKILLS (load first when available):
- /figma-use \u{2014} MANDATORY before calling use_figma
- /figma-generate-design \u{2014} for translating an app page or layout into Figma
- /figma-generate-library \u{2014} for building a design system in Figma from code
- /figma-code-connect \u{2014} for mapping Figma components to codebase components
- /figma-use-figjam \u{2014} for FigJam-specific use_figma flows
- /figma-generate-diagram \u{2014} MANDATORY before calling generate_diagram`,(r=[]).includes("pixie_mcp_enable_design_to_code_skill")&&r.includes("pixie_mcp_get_design_context_legacy_description")&&(n+=`
- /figma-design-to-code \u{2014} MANDATORY before calling get_design_context`),a=n;let l="get_design_context",d="get_code",c="get_image",u="get_screenshot",p="get_metadata",m="get_code_connect_map",h="get_code_connect_suggestions",g="get_strategy_for_mapping",_="send_code_connect_mappings",f="send_get_strategy_response",y="get_variable_defs",A="get_figjam",b="add_code_connect_map",I="set_codegen_config",v="initiate_design_to_code_workflow",E=`IMPORTANT: After you call this tool, you MUST call ${u} to get a screenshot of the node for context.`,S="If the URL is of the format https://figma.com/design/:fileKey/branch/:branchKey/:fileName then use the branchKey as the fileKey.",T="Use the nodeId parameter to specify a node id. If no node id is provided, the currently selected node will be used. If a URL is provided, extract the node id from the URL, for example, if given the URL https://figma.com/design/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2`.";function C({isRemote:e,includeMakeInstruction:t,includeScreenshotHint:i,includeQueryHint:n,includeDesignToCodeSkillHint:r}){let a=r?"Get design context for a Figma node \u2014 the primary tool for design-to-code workflows. Returns reference code, a screenshot, and contextual metadata that must be adapted to the target project. \n\nIMPORTANT: You MUST load figma-design-to-code guidance BEFORE calling this tool. Prefer the /figma-design-to-code skill if available; otherwise read the skill://figma/figma-design-to-code/SKILL.md MCP resource. \n\nNEVER call this tool without loading that guidance first \u2014 skipping it produces code that ignores the target project's existing components, design tokens, and conventions.\n\n":"Get design context for a Figma node \u2014 the primary tool for design-to-code workflows. Returns reference code, a screenshot, and contextual metadata that should be adapted to the target project. See the server instructions for how to interpret and adapt the response. \n\n",s=n?'\n\nJSON projection mode: pass `format: "json"` with a `query` (a CSS selector, same grammar as `node.query()` in the Plugin API) to skip codegen and return a structured list of matched nodes instead of code \u2014 use it to read specific fields from specific nodes rather than generating a whole screen. The `format`, `query`, `depth`, `values`, and `limit` parameters document the full mechanics.':"";return e?a+"Use the nodeId parameter to specify a node id. Use the fileKey parameter to specify the file key. If a URL is provided, extract the node id and file key from the URL, for example, if given the URL https://figma.com/design/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2` and the fileKey would be `:fileKey`. If the URL does not include `node-id`, ask the user for a node-specific URL. Do not pass an empty or guessed nodeId. "+S+" "+(t?"If the URL is of the format https://figma.com/make/:makeFileKey/:makeFileName then use the makeFileKey to identify the Figma Make file. ":"")+"Only for Figma Make files (URLs containing `/make/`), and only when calling get_design_context, assume the nodeId is `0:1`. The response will contain a code string and a JSON of download URLs for the assets referenced in the code."+(i?" It will also include a screenshot of the node for context by default.":"")+s:a+T+" "+S+(i?" It will also include a screenshot of the node for context by default.":"")+s}function w({isRemote:e}){return e?"Generate UI code for a given FigJam node in Figma. Use the nodeId parameter to specify a node id. If no node id is provided, use `0:1` which is the root node ID. Use the fileKey parameter to specify the file key. If a URL is provided, extract the node id from the URL, for example, if given the URL https://figma.com/board/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2` and the fileKey would be `:fileKey`. IMPORTANT: This tool only works for FigJam files (URL path `/board/`), not other Figma files.":"Generate UI code for a given FigJam node or the currently selected FigJam node in the Figma desktop app. Use the nodeId parameter to specify a node id. If no node id is provided, the currently selected node will be used. If a URL is provided, extract the node id from the URL, for example, if given the URL https://figma.com/board/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2`. IMPORTANT: This tool only works for FigJam files (URL path `/board/`), not other Figma files."}function k(e){let t;return"A design agent that modifies existing Figma layer trees \u2014 refining layouts, restyling, rearranging content, polishing visuals, and restructuring. Applies its own design judgment. Works on layers both within and outside of components.\n\n**Parameters:**\n\n- `editableNodeIds` (required): Nodes the agent will modify.\n\n"+("- `instructions`: The user's modification request, close to verbatim"+((t=e.passThroughSkillInstructions??!1)?" \u2014 but treat any explicit values from the user's prompt or an invoked /skill (named fonts, hex codes, named components, specific weights/sizes) as user-authored constraints to thread through, not as embellishment to strip":"")+". The agent makes its own design decisions, so don't add your own design specs or invent details"+(t?" the user didn't ask for":"")+" \u2014 that overrides the agent's judgment and tends to produce generic results. DO resolve short or anaphoric follow-ups by stitching in conversation context the agent doesn't have"+(t?", including skill-specified values that should apply to the edit":"")+'.\n  - Example \u2014 User: "Make a blue button" \u2192 "Make a blue button" (NOT "Create a button with border-radius: 8px, blue background (#0066FF), white text, padding 12px..."'+(t?" \u2014 that's your invention, not the user's spec":"")+')\n  - Example \u2014 User (after asking for 5 buttons): "One less" \u2192 "One less button" (NOT "One less" \u2014 the agent doesn\'t know what "one less" refers to)')+(t?'\n  - Example \u2014 User (with a /skill invoked that names "Helvetica" as the typeface): "Update the header text" \u2192 "Update the header text using Helvetica" (thread the skill\'s named font through \u2014 it counts as user input, not your embellishment)':"")+'\n\n- `references`: Existing designs the agent should read but not modify.\n  - `nodeIds`: Node IDs already in the file \u2014 frames as style/layout reference (e.g. "make this card match the style of this other section"), or raster image nodes the user imported (screenshots, photos, mockups). Pass actual node IDs so the agent reads the layer tree and the rendered visual; the server picks the right treatment per node.\n\n- `designSystem`: Pass through the JSON output from the `explore-design-systems` subagent verbatim \u2014 its `relevantComponents` / `relevantStyles` / `relevantVariables` arrays of `{assetId, name, libraryName, guidelines}` map directly onto this field. Forward all entries in full; the agent decides what to use.\n\n**Limitations:**\n- Cannot find or search for nodes \u2014 provide all node IDs upfront\n- Cannot create components, component sets, styles, or variables (but can use those provided)\n- Cannot create or edit vector paths \u2014 only basic shapes and built-in icons\n- Can generate new images but cannot edit pixels of existing images\n\nIf the tool fails because target nodes have missing fonts, explain that local fonts are not supported in the remote edit environment. Only after the user explicitly accepts proceeding despite missing fonts or incorrect typography, call again with `proceedWithMissingFonts` set to true.'}function R(e){let t;return"A design agent with strong design skills and taste \u2014 creates new Figma designs from scratch, with built-in image generation. Use this when there are no existing nodes to edit.\n\n**Parameters:**\n\n"+("- `instructions`: A high-level creative brief: artifact identity + register + 2\u20134 taste anchors"+((t=e.passThroughSkillInstructions??!1)?" + any explicit values the user has specifically requested (named fonts, hex codes, pixel counts, named components)":"")+'. The agent\'s skill catalog isn\'t visible to you at runtime; your brief steers it toward a coherent region of design space, then it handles layout, composition, styling, and per-section content. Register names a coherent design language (mood/tone/theme/style bundled \u2014 e.g. "luxurious editorial", "tactical operator console", "minimal SaaS", "brutalist citron", "slow-fashion palette", "moody architectural noir"). '+(t?'Anchors are discipline-level: type-class pairings, palette disciplines, signature layout moves, color-restraint rules \u2014 never invent hex codes, font names, or pixel counts the user didn\'t ask for; those are the agent\'s job to pick. Explicit values are a separate input from anchors: when the user\'s prompt or an invoked /skill names concrete values (e.g. "Helvetica" or "Roboto" as the typeface, specific hex codes, named components from a library, specific weights/sizes), include them verbatim in `instructions` as user-authored constraints \u2014 pass them through and treat them as mandates, not suggestions. Never paraphrase a named asset as "simulate", "inspired by", or "reminiscent of", and don\'t substitute thematically-adjacent alternatives.':"Anchors are discipline-level: type-class pairings, palette disciplines, signature layout moves, color-restraint rules \u2014 never hex codes, font names, or pixel counts (those are the agent's job).")+' Match the user\'s level of detail \u2014 pass through specs they typed (columns, colors, fonts, pixel sizes), don\'t invent ones they didn\'t. For variations, declare a variation set and name distinct registers \u2014 the agent locks shared content across the set on its own. Brief each variation at the same scope as a single-design brief; N variations multiply the work, not divide it. Never specify screen-level pixel dimensions the user didn\'t give you \u2014 no "1440\xd7900", "desktop 1440", or canvas/section sizes; the agent picks dimensions from natural scale. For implied platforms write "desktop layout" or "mobile screen", not a number. Each screen or variation must be a complete design at the artifact\'s natural scale (landing pages: 8\u201312 sections; dashboards: full surface) \u2014 never a stub or preview.\n  - Example \u2014 User: "Design a landing page for an alpine expedition company called SummitForge" \u2192 "Landing page for SummitForge, an alpine expedition outfitter \u2014 full 8\u201312 sections. High-altitude editorial \u2014 photo-bracketed, safety-orange punctuation, industrial confidence."\n  - Example \u2014 User: "Create a 4-screen food delivery app for Anelia, a Greek caf\xe9" \u2192 "4-screen food delivery app for Anelia, a Greek caf\xe9. Luxe late-night monochrome \u2014 no-accent alpha-step hierarchy, arched-tombstone cafe cards, image-as-fill with bottom-fade scrim."\n  - Example \u2014 User: "3 dashboard concepts for Contra Labs, a product analytics SaaS" \u2192 "3 dashboard variations for Contra Labs, a product analytics SaaS \u2014 each a full-surface dashboard with standard nav + KPIs + charts + tables scope (same across all three; registers re-clothe). Three distinct registers: Linear/Vercel restraint (single-family type discipline, color reserved for data, no-hero weight-even card grid) / vintage-almanac sepia (hairline-ruled structure, print-masthead topbar, cartographic accent palette) / Apple HIG glassmorphism (atmospheric gradient \xd7 frosted-glass tiles, asymmetric hero hierarchy, Apple-system perceptual cohort ramp)."\n  - Example \u2014 User: "3 landing page concepts for Clarity Dental, a modern family dentistry" \u2192 "3 landing page variations for Clarity Dental, a modern family dentistry \u2014 each a full 8\u201312 section landing page with standard hero + services + team + social proof + CTA scope (same across all three; registers re-clothe). Three distinct registers: warm-mauve family-portrait editorial (serif \xd7 grotesk warmth, staggered team grid) / pastel soft-modern DTC (multi-pastel section banding, floating rounded cards) / dark-slate premium aesthetic clinic (peach-on-slate, mono kickers)."')+(t?'\n  - Example \u2014 User (with `/brand-kit` skill specifying Helvetica typeface and #2D5BFF as the primary accent): "Marketing landing page for FlowMint, a B2B fintech" \u2192 "Landing page for FlowMint, a B2B fintech. Modern operator-console register \u2014 restrained color discipline, single-family type hierarchy. Explicit values from /brand-kit (pass through verbatim): Helvetica typeface, #2D5BFF primary accent."':"")+"\n\n- `references.nodeIds`: Existing Figma frames or raster image nodes **in the current file you're creating in** \u2014 read-only references the agent reads but doesn't modify. Pass actual node IDs (not pasted images); the server reads the layer tree, components, and variables and picks the right treatment per node. NEVER pass node IDs from an attached file or any other file. To reference content from an attachment, describe it in `instructions` instead.\n\n- `designSystem`: Pass through the JSON output from the `explore-design-systems` subagent verbatim \u2014 its `relevantComponents` / `relevantStyles` / `relevantVariables` arrays of `{assetId, name, libraryName, guidelines}` map directly onto this field.\n\n- `placeholderFrames`: `{ width, height, frame_name }` entries used only to render on-canvas progress placeholders while the tool runs. Width and height are dummies \u2014 pass rough estimations, don't overthink. They do NOT constrain the final design; the agent sets real dimensions from natural scale (final frame count and dimensions can all differ). **The dimensions you write here are scoped to this parameter only.** Never echo them into `instructions` (no \"1440\xd7900 dashboard\", no \"desktop 1440\"), and don't let filling these in prime you to add pixel sizes to the brief \u2014 `instructions` and `placeholderFrames` are independent.\n\n**Limitations:**\n- Cannot create components, component sets, styles, or variables (but can use those provided)\n- Cannot create or edit vector paths \u2014 only basic shapes and built-in icons\n- Can generate new images but cannot edit pixels of existing images\n\n**Retry contract:** If `create_design` returns an error and does not provide a structured remediation (e.g. missing font with `proceedWithMissingFonts`), do not re-call with the same instructions. Tell the user what happened. The prompt-shape failure modes repeat \u2014 a retry with the same brief produces the same failure."}w({isRemote:!1}),!function({includePlaywrightInstruction:e}){}({includePlaywrightInstruction:!0}),k({}),k({passThroughSkillInstructions:!0}),!function({enableCrossFileRead:e=!1}={}){}(),R({}),R({passThroughSkillInstructions:!0});let N=({enableCrossFileRead:e=!1}={})=>"Use this tool to search for Figma files by name or keyword. "+(e?"Returns file-level metadata only \u2014 not file contents. To read the contents outside the current file (e.g. a search result or an attached file) follow the read-file-context skill (routes to the right reader: Design, FigJam, or Slides). Only tell the user to view it themselves if no reader applies. ":"You are unable to read the contents of files returned in search results, unless it is a figjam file and you have access to the tool: get_figjam_context. Otherwise, if a user asks about the content of a file that is NOT the current file you are operating in (its pages, frames, layers, etc.), you cannot help even if the file is open somewhere else. Tell them they need to view it themselves. ")+'Read-only; finds existing files. Supports org/team/folder scope and creator/editor/viewer/comment/time filters. Resolve any team or folder names via search_teams or search_folders first, then pass the IDs to narrow results. Apply optional filters only when explicitly requested. To find a specific page, frame, screen, flow, or layout inside a file, prefer search_files_by_fragment for semantic search. Default to `viewedByUser: true` \u2014 files the user has seen are more likely relevant. Skip it only if the user asks for unseen files or filters by creator/editor instead. For edited/modified/worked-on, use editor filters (editedByUser/editedByIds/editedByIdsAfterTimestampIso8601); skip viewedBy unless that returns empty. In prose say "last edited"/"last modified" \u2014 never expose the raw `touchedAt` field name. Render results as <figma-files-preview-grid file-keys="key1,key2,..." /> (even for a single file). Put prose first, then the tag at the end. Never use markdown or text for file results. Include at most 10 file keys per response; pick the most relevant if results exceed 10. Never emit multiple preview-grid tags in one response. \nResults are stable within a turn \u2014 do not re-issue the same arguments, including when the result is empty.';N(),(({enableCrossFileRead:e=!1}={})=>N({enableCrossFileRead:e}))(),(({enableCrossFileRead:e=!1}={})=>0)();let P="get_code_for_selection",O="create_design_system_rules",D="map_selection_to_code_connect",F="Prompt to generate code for the currently selected design elements in Figma",L="Provides a prompt to generate design system rules for this repo.",M="Provides a prompt to map the currently selected design elements in Figma to code components in the codebase using Code Connect.";function j({exposeAssetWriteDirectoryOption:e,gatherUsageMetrics:t,exposeScreenshotOption:i}){return{name:l,description:C({isRemote:!1,includeMakeInstruction:!1,includeScreenshotHint:i}),annotations:{readOnlyHint:!0},inputSchema:(0,s.Ik)((0,o.lz8)({exposeAssetWriteDirectoryOption:e,gatherUsageMetrics:t,exposeScreenshotOption:i}),{strictUnions:!0})}}C({isRemote:!1,includeMakeInstruction:!1}),(0,s.Ik)((0,o.lz8)({exposeAssetWriteDirectoryOption:!1,gatherUsageMetrics:!1}),{strictUnions:!0}),C({isRemote:!1,includeMakeInstruction:!1}),(0,s.Ik)((0,o.lz8)({exposeAssetWriteDirectoryOption:!0,gatherUsageMetrics:!1}),{strictUnions:!0});let U={name:p,description:function({isRemote:e,noDc:t,includeSelectionState:i}){let n=t?"Get metadata for a node or page in the Figma desktop app in XML format. Useful only for getting an overview of the structure, it only includes node IDs, layer types, names, positions and sizes. Use the nodeId parameter to specify a node id, it can also be the page id (e.g. 0:1). IMPORTANT: This tool only works for Figma design files (URL path `/design/`). It is NOT supported for FigJam (`/board/`) or Slides (`/slides/`) files. This tool is not supported for Figma Make Files (URLs containing `/make/`). ":`IMPORTANT: Always prefer to use ${l} tool. Get metadata for a node or page in the Figma desktop app in XML format. Useful only for getting an overview of the structure, it only includes node IDs, layer types, names, positions and sizes. You can call ${l} on the node IDs contained in this response. Use the nodeId parameter to specify a node id, it can also be the page id (e.g. 0:1). IMPORTANT: This tool only works for Figma design files (URL path \`/design/\`). It is NOT supported for FigJam (\`/board/\`) or Slides (\`/slides/\`) files. This tool is not supported for Figma Make Files (URLs containing \`/make/\`). `,r=i?'When the user has a current selection relevant to the request, the response is prepended with a "Currently selected nodes:" block listing the selection by guid and name, so you can tell whether it matches the queried nodeId. ':"";return e?n+"The nodeId parameter is optional: when omitted, the tool returns a list of the top-level pages (guid + name) in the document instead of an XML dump \u2014 use this when you don't yet know which page or node to drill into. "+r+"If the URL includes `node-id`, extract it and pass it as nodeId; for example, if given the URL https://figma.com/design/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2`. If the URL does not include `node-id`, do not set nodeId; omit the field so the tool lists top-level pages. Do not pass an empty or guessed nodeId. "+S:n+"If no node id is provided, the currently selected node will be used. If no node id is provided and nothing is selected, the tool returns a list of the top-level pages (guid + name) in the document instead of an XML dump \u2014 use this when you don't yet know which page or node to drill into, then call back with a page id to fetch its structure. "+r+"If a URL is provided, extract the node id from the URL, for example, if given the URL https://figma.com/design/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2`. "+S}({isRemote:!1}),annotations:{readOnlyHint:!0},inputSchema:(0,s.Ik)(o.ai_,{strictUnions:!0})},B={name:y,description:function({isRemote:e}){let t="Get variable definitions for a given node id. E.g. {'icon/default/secondary': #949494}Variables are reusable values that can be applied to all kinds of design properties, such as fonts, colors, sizes and spacings. Use the nodeId parameter to specify a node id. ";return e?t+"Extract the node id from the URL, for example, if given the URL https://figma.com/design/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2`. If the URL does not include `node-id`, ask the user for a node-specific URL. Do not pass an empty or guessed nodeId. This remote tool requires a concrete node target. This tool is not supported for Figma Make Files (URLs containing `/make/`). "+S:t+"If no node id is provided, the currently selected node will be used. If a URL is provided, extract the node id from the URL, for example, if given the URL https://figma.com/design/:fileKey/:fileName?node-id=1-2, the extracted nodeId would be `1:2`. "+S}({isRemote:!1}),annotations:{readOnlyHint:!0},inputSchema:(0,s.Ik)(o.ai_,{strictUnions:!0})},G={name:m,description:"Get a mapping of {[nodeId]: {codeConnectSrc: e.g. location of component in codebase, codeConnectName: e.g. name of component in codebase} E.g. {'1:2': { codeConnectSrc: 'https://github.com/foo/components/Bu