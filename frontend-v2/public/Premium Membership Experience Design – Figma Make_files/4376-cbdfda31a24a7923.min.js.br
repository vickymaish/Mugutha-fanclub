        headersObject: Object.fromEntries(response.headers.entries()),
        ok: response.ok,
        redirected: response.redirected,
        status: response.status,
        statusText: response.statusText,
        type: response.type,
        url: response.url,
      }
      window.parent.postMessage({id, data: responseData}, '*')
    } catch(error) {
